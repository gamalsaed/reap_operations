<odoo>
        <record id="project_sequence" model="ir.sequence" >
            <field name="name" >Project Sequence</field>
            <field name="code" >project_seq</field>
            <field name="prefix" >PRJ</field>
            <field name="padding" >5</field>
        </record>
        <record id="site_sequence" model="ir.sequence" >
            <field name="name" >Site Sequence</field>
            <field name="code" >site_seq</field>
            <field name="prefix" >SE</field>
            <field name="padding" >5</field>
        </record>
        <record id="request_sequence" model="ir.sequence" >
            <field name="name" >Request Sequence</field>
            <field name="code" >request_seq</field>
            <field name="prefix" >REQ/%(y)s/</field>
            <field name="padding" >5</field>
        </record>
</odoo>