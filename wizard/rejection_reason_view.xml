<odoo>
    <record id="rejection_reason_wizard_form" model="ir.ui.view" >
        <field name="name" >Rejection Reason Form</field>
        <field name="model" >rejection.reason</field>
        <field name="arch" type="xml" >
            <form>
                <group>
                    <field name="request_id" invisible="1" />
                    <field name="reason"  />
                </group>
                <footer>
                    <button special="cancel" class="btn-secondary" >
                        Cancel
                    </button>
                    <button string="Save" class="btn-primary" type="object" name="handle_rejection_save" />
                </footer>
            </form>
        </field>
    </record>
</odoo>