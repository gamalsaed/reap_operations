<odoo>
    <record id="enterprise_product_mapping_wizard_form" model="ir.ui.view" >
        <field name="name" >Product Mapping</field>
        <field name="model" >enterprise.product.mapping.wizard</field>
        <field name="arch" type="xml" >
            <form>
                <group>
                    <field name="request_line_id" invisible="1" />
                    <field name="request_description" string="Description" />
                    <field name="product_id" string="Product" />
                </group>
                <footer>
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                    <button string="Save" type="object" class="btn-primary" name="handle_map_save" />
                </footer>
            </form>
        </field>
    </record>
</odoo>