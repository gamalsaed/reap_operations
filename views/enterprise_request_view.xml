<odoo>

    <record id="enterprise_request_form_view" model="ir.ui.view" >
        <field name="name" >Enterprise Request Form</field>
        <field name="model" >enterprise.request</field>
        <field name="arch" type="xml" >
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group class="d-flex justify-content-between" >
                        <h1>
                            <field name="name" readonly="True" />
                        </h1>
                        <div class="d-flex gap-3" >
                            <button
                                name="approved_handler"
                                type="object"
                                string="Approve"
                                invisible="state not in ('submitted','rejected')"
                                groups="reap_operations.group_reap_manager"
                                class="oe_stat_button bg-success text-white"
                            />
                            <button
                                name="action_open_rejection_wizard"
                                type="object"
                                string="Reject"
                                invisible="state != 'submitted'"
                                groups="reap_operations.group_reap_manager"
                                class="oe_stat_button bg-danger text-white"
                            />
                        </div>
                    </group>

                    <group>
                        <field name="priority"/>
                        <field name="request_date"/>
                        <field name="requester_id"/>
                        <field name="department_id"/>
                        <field name="partner_id"/>
                    </group>

                    <group>
                        <field name="project_id"/>
                        <field name="site_id"/>
                        <field name="request_type"/>
                        <field name="required_date"/>
                    </group>

                    <group>
                        <field name="description"/>
                        <field name="rejection_reason" class="text-red" string="Rejection Reason" invisible="state != 'rejected'" />
                    </group>

                    <notebook>
                        <page string="Request Items">
                            <field name="line_ids">
                                <list>
                                    <field name="request_id" />
                                    <field name="product_id" />
                                    <field name="product_uom_id" />
                                    <field name="product_status" />
                                    <field name="quantity" />
                                    <field name="estimated_unit_price" />
                                    <field name="subtotal" />
                                </list>
                            </field>
                        </page>
                    </notebook>

                        <group>
                            <field name="total_estimated"/>
                            <button invisible="state != 'draft'" class="oe_stat_button bg-primary text-white" type="object" name="submit_handler"  >Submit</button>
                        </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="enterprise_request_list_view" model="ir.ui.view" >
        <field name="name" >Enterprise Request Tree</field>
        <field name="model" >enterprise.request</field>
        <field name="arch"  type="xml">
            <list>
                <field name="name" />
                <field name="request_date" />
                <field name="requester_id" />
                <field name="department_id" />
                <field name="partner_id" />
                <field name="project_id" />
                <field name="site_id" />
                <field name="request_type" />
                <field name="required_date" />
                <field name="priority" />
            </list>
        </field>
    </record>

    <record id="enterprise_request_action" model="ir.actions.act_window" >
        <field name="name" >Enterprise Request Hub</field>
        <field name="res_model" >enterprise.request</field>
        <field name="view_mode" >list,form</field>
    </record>
</odoo>