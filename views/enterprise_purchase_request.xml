<odoo>

    <record id="enterprise_purchase_request_list" model="ir.ui.view" >
        <field name="name" >Enterprise Purchase Request List</field>
        <field name="model" >enterprise.purchase.request</field>
        <field name="arch" type="xml" >
            <list>
                <field name="name" />
                <field name="source_request_id" />
                <field name="project_id" />
                <field name="site_id" />
                <field name="purchase_type" />
                <field name="requester_id" />
                <field name="required_date" />
            </list>
        </field>
    </record>

    <record id="enterprise_purchase_request_form" model="ir.ui.view"  >
        <field name="name" >Enterprise Purchase Request Form</field>
        <field name="model" >enterprise.purchase.request</field>
        <field name="arch" type="xml" >
            <form create="false" edit="false" delete="false" >
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group class="d-flex justify-content-between" >
                        <h1>
                            <field name="name" readonly="True" />
                        </h1>
                        <div class="d-flex gap-3" >
                            <button
                                name="handle_approve"
                                type="object"
                                string="Approve"
                                invisible="state not in ('submitted','cancel')"
                                groups="reap_operations.group_reap_manager"
                                class="oe_stat_button bg-success text-white"
                            />
                            <button
                                name="handel_cancel"
                                type="object"
                                string="Cancel"
                                invisible="state not in ('closed','approved','cancel')"
                                groups="reap_operations.group_reap_manager"
                                class="oe_stat_button bg-danger text-white"
                            />
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="source_request_id" />
                            <field name="project_id" />
                            <field name="site_id" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="purchase_type" />
                            <field name="requester_id" />
                            <field name="required_date" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Lines" ><field name="line_ids" widget="one2many" >
                            <list>
                                <field name="request_id" />
                                <field name="product_id" />
                                <field name="product_uom_id" />
                                <field name="product_status" />
                                <field name="quantity" />
                                <field name="estimated_unit_price" />
                                <field name="subtotal" />
                            </list>
                        </field></page>
                        <page string="Purchase Lines" ><field name="purchase_request_lines" >
                            <list>
                                <field name="request_id" />
                                <field name="purchase_request_id" />
                                <field name="product_id" />
                                <field name="requested_qty" />
                                <field name="available_qty" />
                                <field name="purchase_qty" />
                                <field name="uom_id" />
                                <field name="estimated_unit_price" />
                            </list>
                        </field></page>
                    </notebook>
                    <button 
                        string="Submit"
                        type="object"
                        class="btn-primary"
                        name="handle_submit"
                     />
                </sheet>
            </form>
        </field>
    </record>



    <record id="enterprise_purchase_request_action" model="ir.actions.act_window" >
        <field name="name" >Enterprise Purchase Request</field>
        <field name="res_model" >enterprise.purchase.request</field>
        <field name="view_mode" >list,form</field>
    </record>
</odoo>
