<odoo>
    <record id="enterprise_request_line_form" model="ir.ui.view" >
        <field name="name" >Enterprise Request Line Form</field>
        <field name="model" >enterprise.request.line</field>
        <field name="arch" type="xml" >
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id" />
                            <field name="product_id" />
                            <field name="currency_id" />
                            <field name="requested_description" />
                            <field name="estimated_unit_price" />
                        </group>
                        <group>
                            <field name="product_status" />
                            <field name="product_uom_id" />
                            <field name="quantity" />
                            <field name="subtotal" />
                        </group>
                    </group>
                    <div class="d-flex justify-content-end" >
                        <button string="Map Product" invisible="product_status == 'known'" class="btn-primary" type="object" name="map_product_action" />
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>